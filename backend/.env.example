# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/vardrmap

# Random secret shared between backend and frontend for JWT signing.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BACKEND_JWT_SECRET=change-me-to-a-long-random-hex-string

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Set to "development" locally; Railway sets RAILWAY_ENVIRONMENT_NAME automatically
ENV=development

# Max file size for tool imports in bytes (default 2 MB)
MAX_UPLOAD_BYTES=2097152

# Anthropic API key — required for POST /programs/{id}/findings/{id}/suggest (AI triage).
# If absent, the endpoint returns 503. Obtain at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
