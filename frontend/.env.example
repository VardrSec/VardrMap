# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is gitignored.

# URL of this Next.js app (used by NextAuth for redirects)
NEXTAUTH_URL=http://localhost:3000

# Random secret for Auth.js session encryption.
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# GitHub OAuth App credentials — create one at:
# https://github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your-github-oauth-app-client-id
AUTH_GITHUB_SECRET=your-github-oauth-app-client-secret

# Must match BACKEND_JWT_SECRET in backend/.env exactly
BACKEND_JWT_SECRET=change-me-to-a-long-random-hex-string

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
